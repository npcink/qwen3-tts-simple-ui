# Local backend endpoints. Keep model services bound to loopback.
QWEN_TTS_BACKEND_URL=http://127.0.0.1:18000
QWEN_TTS_BASE_BACKEND_URL=http://127.0.0.1:18002
QWEN_TTS_ASR_BACKEND_URL=http://127.0.0.1:18003

# All generated files, temporary uploads, logs and audit records live here.
QWEN_TTS_DATA_DIR=.runtime
QWEN_TTS_OUTPUT_RETENTION_SECONDS=86400
QWEN_TTS_MAX_TEXT_LENGTH=800
QWEN_TTS_MAX_REFERENCE_AUDIO_BYTES=31457280

# UI Host headers accepted by the application. Add the authenticated reverse
# proxy hostname here only when intentionally enabling LAN access.
QWEN_TTS_ALLOWED_HOSTS=127.0.0.1,localhost

# Shared by the UI and ASR processes.
QWEN_TTS_GPU_LOCK_FILE=.runtime/gpu-inference.lock
QWEN_TTS_GPU_LOCK_TIMEOUT_SECONDS=900

# Optional. Set an absolute path when SoX is not on PATH.
QWEN_TTS_SOX_BINARY=

# Optional Japanese ASR settings.
ASR_MODEL=large-v3-turbo
ASR_MODEL_CACHE=.runtime/asr-cache
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
